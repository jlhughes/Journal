p({class:"foam.core.reflow.Flow",name:"AccountLedger",spid:"foam",script:"[\n\t{\n\t\t\n\t\t\"flowName\": \"user\",\n\t\t\"cmd\": \"dao user\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.DAOPrompt\",\n\t\t\t\"label\": \"User\",\n\t\t\t\"columns\": \"id,type,lifecycleState,userName,group.id,email\",\n\t\t\t\"select\": {\n\t\t\t\t\"class\": \"foam.core.reflow.ObjectSelectDAOAgent\"\n\t\t\t},\n\t\t\t\"labelVisible\": false\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\"cssClasses\": [\n\t\t\t\t\n\t\t\t]\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"account\",\n\t\t\"cmd\": \"dao account\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.DAOPrompt\",\n\t\t\t\"label\": \"Account\",\n\t\t\t\"where\": \"owner:undefined\",\n\t\t\t\"columns\": \"summary,balance\",\n\t\t\t\"select\": {\n\t\t\t\t\"class\": \"foam.core.reflow.ObjectSelectDAOAgent\"\n\t\t\t},\n\t\t\t\"labelVisible\": false,\n\t\t\t\"reactions_\": {\n\t\t\t\t\"where\": \"`owner:${user.value?.id}`\"\n\t\t\t}\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\"cssClasses\": [\n\t\t\t\t\n\t\t\t]\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"generate_ledger\",\n\t\t\"cmd\": \"script\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.Script\",\n\t\t\t\"code\": \"let exp = foam.mlang.Expressions.create();\\u000a\\u000a// let led = globalThis.ledgerEntryDAO;\\u000alet led = this.__subContext__.ledgerEntryDAO;\\u000aif ( led ) {\\u000a    await led.removeAll();\\u000a}\\u000a\\u000aif ( ! user || ! user.value ) return;\\u000aconsole.log('user', user.value.id);\\u000aif ( ! account || ! account.value ) return;\\u000aconsole.log('account', account.value.id);\\u000a\\u000alet td = this.__subContext__.transactionDAO\\u000a    .where(exp.OR(\\u000a        exp.EQ(hughes.ledger.Transaction.CREDIT_ACCOUNT, account.value.id),\\u000a        exp.EQ(hughes.ledger.Transaction.DEBIT_ACCOUNT, account.value.id)\\u000a        ))\\u000a    .orderBy(hughes.ledger.Transaction.CREATED);\\u000a\\u000alet s = await td.select();\\u000alet a = s.array;\\u000aif ( ! a ) return;\\u000a\\u000aconsole.log('transactions', a.length);\\u000avar balance = 0;\\u000afor ( const t of a ) {\\u000a    if ( ! t.event ) {\\u000a        console.log('skip, no event', t.id); \\u000a        continue;\\u000a    }\\u000a    let e = hughes.ledger.LedgerEntry.create({\\u000a        id: t.id,\\u000a        date: t.created,\\u000a        event: t.event,\\u000a        creditAccount: t.creditAccount,\\u000a        debitAccount: t.debitAccount\\u000a    });  \\u000a    if ( account.value.id == t.creditAccount ) {\\u000a        e.creditAmount = t.total;\\u000a        balance += e.creditAmount;\\u000a    } else {\\u000a        e.debitAmount = t.total;\\u000a        balance -= e.debitAmount;\\u000a    }\\u000a    e.balance = balance;\\u000a    led.put(e);\\u000a}\",\n\t\t\t\"autoRun\": true\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\"cssClasses\": [\n\t\t\t\t\n\t\t\t],\n\t\t\t\"shown\": false\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"button1\",\n\t\t\"cmd\": \"button\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.cmd.Button.FlowAction\",\n\t\t\t\"script\": \"await generate_ledger.run();\",\n\t\t\t\"name\": \"flowButton_7620\",\n\t\t\t\"label\": \"Generate Ledger\",\n\t\t\t\"icon\": \"\",\n\t\t\t\"availablePermissions\": [\n\t\t\t\t\n\t\t\t],\n\t\t\t\"enabledPermissions\": [\n\t\t\t\t\n\t\t\t],\n\t\t\t\"confirmationRequiredPermissions\": [\n\t\t\t\t\n\t\t\t]\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"ledger\",\n\t\t\"cmd\": \"dao ledgerEntry\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.DAOPrompt\",\n\t\t\t\"label\": \"Ledger\",\n\t\t\t\"limit\": 1000,\n\t\t\t\"order\": \"-date\",\n\t\t\t\"columns\": \"date,event,debitAmount,creditAmount,balance\",\n\t\t\t\"select\": {\n\t\t\t\t\"class\": \"foam.core.reflow.TableDAOAgent\",\n\t\t\t\t\"columns\": [\n\t\t\t\t\t\"date\",\n\t\t\t\t\t\"event\",\n\t\t\t\t\t\"debitAmount\",\n\t\t\t\t\t\"creditAmount\",\n\t\t\t\t\t\"balance\"\n\t\t\t\t],\n\t\t\t\t\"selection\": \"62aa65af1daad54\",\n\t\t\t\t\"groupBy\": null\n\t\t\t},\n\t\t\t\"labelVisible\": false\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\"cssClasses\": [\n\t\t\t\t\n\t\t\t]\n\t\t}\n\t}\n]",created:1758982250200,createdBy:100670982,lastModified:1759016575904})

