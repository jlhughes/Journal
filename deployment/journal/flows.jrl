p({class:"foam.core.reflow.Flow",name:"AccountLedger",script:"[\n\t{\n\t\t\n\t\t\"flowName\": \"setup\",\n\t\t\"cmd\": \"script\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.Script\",\n\t\t\t\"code\": \"var f = this.findFlowChildByName('user');\\u000aif ( f ) f.block.shown = true;\\u000avar f = this.findFlowChildByName('account');\\u000aif ( f ) f.block.shown = true;\\u000avar f = this.findFlowChildByName('button1');\\u000aif ( f ) f.block.shown = true;\",\n\t\t\t\"autoRun\": true\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\"cssClasses\": [\n\t\t\t\t\n\t\t\t],\n\t\t\t\"shown\": false\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"user\",\n\t\t\"cmd\": \"dao user\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.DAOPrompt\",\n\t\t\t\"label\": \"User\",\n\t\t\t\"columns\": \"id,type,lifecycleState,userName,group.id,email\",\n\t\t\t\"select\": {\n\t\t\t\t\"class\": \"foam.core.reflow.ObjectSelectDAOAgent\"\n\t\t\t},\n\t\t\t\"labelVisible\": false\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\"cssClasses\": [\n\t\t\t\t\n\t\t\t]\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"account\",\n\t\t\"cmd\": \"dao account\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.DAOPrompt\",\n\t\t\t\"label\": \"Account\",\n\t\t\t\"where\": \"owner:undefined\",\n\t\t\t\"columns\": \"summary,balance\",\n\t\t\t\"select\": {\n\t\t\t\t\"class\": \"foam.core.reflow.ObjectSelectDAOAgent\"\n\t\t\t},\n\t\t\t\"labelVisible\": false,\n\t\t\t\"reactions_\": {\n\t\t\t\t\"where\": \"`owner:${user.value?.id}`\"\n\t\t\t}\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\"cssClasses\": [\n\t\t\t\t\n\t\t\t]\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"button1\",\n\t\t\"cmd\": \"button\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.cmd.Button.FlowAction\",\n\t\t\t\"script\": \"await generate_ledger.run();\",\n\t\t\t\"name\": \"flowButton_7620\",\n\t\t\t\"label\": \"Regenerate Ledger\",\n\t\t\t\"icon\": \"\",\n\t\t\t\"availablePermissions\": [\n\t\t\t\t\n\t\t\t],\n\t\t\t\"enabledPermissions\": [\n\t\t\t\t\n\t\t\t],\n\t\t\t\"confirmationRequiredPermissions\": [\n\t\t\t\t\n\t\t\t]\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"layout2\",\n\t\t\"cmd\": \"layout\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.u2.layout.Layout\"\n\t\t},\n\t\t\"flowChildren\": [\n\t\t\t{\n\t\t\t\t\n\t\t\t\t\"flowName\": \"title\",\n\t\t\t\t\"cmd\": \"h1\",\n\t\t\t\t\"value\": {\n\t\t\t\t\t\"class\": \"foam.core.reflow.Header\",\n\t\t\t\t\t\"text\": \"Account Ledger\"\n\t\t\t\t},\n\t\t\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\t\t\"border\": {\n\t\t\t\t\t\"cssClasses\": [\n\t\t\t\t\t\t\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t},\n\t\t\t{\n\t\t\t\t\n\t\t\t\t\"flowName\": \"userName\",\n\t\t\t\t\"cmd\": \"h2\",\n\t\t\t\t\"value\": {\n\t\t\t\t\t\"class\": \"foam.core.reflow.Header\",\n\t\t\t\t\t\"type\": \"h2\",\n\t\t\t\t\t\"text\": \"User: Connor H\"\n\t\t\t\t},\n\t\t\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\t\t\"border\": {\n\t\t\t\t\t\"cssClasses\": [\n\t\t\t\t\t\t\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t},\n\t\t\t{\n\t\t\t\t\n\t\t\t\t\"flowName\": \"accountName\",\n\t\t\t\t\"cmd\": \"h2\",\n\t\t\t\t\"value\": {\n\t\t\t\t\t\"class\": \"foam.core.reflow.Header\",\n\t\t\t\t\t\"type\": \"h2\",\n\t\t\t\t\t\"text\": \"Account: Cash\"\n\t\t\t\t},\n\t\t\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\t\t\"border\": {\n\t\t\t\t\t\"cssClasses\": [\n\t\t\t\t\t\t\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t}\n\t\t],\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"layout1\",\n\t\t\"cmd\": \"layout\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.u2.layout.Layout\"\n\t\t},\n\t\t\"flowChildren\": [\n\t\t\t{\n\t\t\t\t\n\t\t\t\t\"flowName\": \"startDate\",\n\t\t\t\t\"cmd\": \"input date\",\n\t\t\t\t\"value\": {\n\t\t\t\t\t\"class\": \"foam.core.reflow.Prompt\",\n\t\t\t\t\t\"label\": \"Start Date\",\n\t\t\t\t\t\"defaultValue\": \"\",\n\t\t\t\t\t\"view\": {\n\t\t\t\t\t\t\"class\": \"foam.u2.view.DateView\",\n\t\t\t\t\t\t\"readView\": {\n\t\t\t\t\t\t\t\"class\": \"foam.u2.view.date.RODateView\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t\"writeView\": {\n\t\t\t\t\t\t\t\"class\": \"foam.u2.DateView\"\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t},\n\t\t\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\t\t\"border\": {\n\t\t\t\t\t\"cssClasses\": [\n\t\t\t\t\t\t\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t},\n\t\t\t{\n\t\t\t\t\n\t\t\t\t\"flowName\": \"endDate\",\n\t\t\t\t\"cmd\": \"input date\",\n\t\t\t\t\"value\": {\n\t\t\t\t\t\"class\": \"foam.core.reflow.Prompt\",\n\t\t\t\t\t\"label\": \"End Date\",\n\t\t\t\t\t\"defaultValue\": \"\",\n\t\t\t\t\t\"view\": {\n\t\t\t\t\t\t\"class\": \"foam.u2.view.DateView\",\n\t\t\t\t\t\t\"readView\": {\n\t\t\t\t\t\t\t\"class\": \"foam.u2.view.date.RODateView\"\n\t\t\t\t\t\t},\n\t\t\t\t\t\t\"writeView\": {\n\t\t\t\t\t\t\t\"class\": \"foam.u2.DateView\"\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t},\n\t\t\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\t\t\"border\": {\n\t\t\t\t\t\"cssClasses\": [\n\t\t\t\t\t\t\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t},\n\t\t\t{\n\t\t\t\t\n\t\t\t\t\"flowName\": \"balance\",\n\t\t\t\t\"cmd\": \"input currency\",\n\t\t\t\t\"value\": {\n\t\t\t\t\t\"class\": \"foam.core.reflow.Prompt\",\n\t\t\t\t\t\"label\": \"Balance\",\n\t\t\t\t\t\"defaultValue\": \"\",\n\t\t\t\t\t\"view\": {\n\t\t\t\t\t\t\"class\": \"foam.u2.CurrencyView\",\n\t\t\t\t\t\t\"precision\": \"2\",\n\t\t\t\t\t\t\"curr_\": \"\",\n\t\t\t\t\t\t\"hideSymbol\": \"true\",\n\t\t\t\t\t\t\"min\": \"\",\n\t\t\t\t\t\t\"max\": \"\",\n\t\t\t\t\t\t\"preventFeedback\": \"\",\n\t\t\t\t\t\t\"placeholder\": \"\",\n\t\t\t\t\t\t\"ariaLabel\": \"\",\n\t\t\t\t\t\t\"autocomplete\": \"true\",\n\t\t\t\t\t\t\"inputMode\": \"\",\n\t\t\t\t\t\t\"mode\": 2\n\t\t\t\t\t}\n\t\t\t\t},\n\t\t\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\t\t\"border\": {\n\t\t\t\t\t\"cssClasses\": [\n\t\t\t\t\t\t\n\t\t\t\t\t]\n\t\t\t\t}\n\t\t\t}\n\t\t],\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"ledger\",\n\t\t\"cmd\": \"dao ledgerEntry\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.DAOPrompt\",\n\t\t\t\"label\": \"Ledger\",\n\t\t\t\"limit\": 1000,\n\t\t\t\"order\": \"-date\",\n\t\t\t\"columns\": \"date,event,debitAmount,creditAmount,balance\",\n\t\t\t\"select\": {\n\t\t\t\t\"class\": \"foam.core.reflow.TableDAOAgent\",\n\t\t\t\t\"columns\": [\n\t\t\t\t\t\"date\",\n\t\t\t\t\t\"event\",\n\t\t\t\t\t\"debitAmount\",\n\t\t\t\t\t\"creditAmount\",\n\t\t\t\t\t\"balance\"\n\t\t\t\t],\n\t\t\t\t\"selection\": \"62aa65af1daad54\"\n\t\t\t},\n\t\t\t\"labelVisible\": false\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\"cssClasses\": [\n\t\t\t\t\n\t\t\t]\n\t\t}\n\t},\n\t{\n\t\t\n\t\t\"flowName\": \"generate_ledger\",\n\t\t\"cmd\": \"script\",\n\t\t\"value\": {\n\t\t\t\"class\": \"foam.core.reflow.Script\",\n\t\t\t\"code\": \"let exp = foam.mlang.Expressions.create();\\u000a\\u000a// let led = globalThis.ledgerEntryDAO;\\u000alet led = this.__subContext__.ledgerEntryDAO;\\u000aif ( led ) {\\u000a    await led.removeAll();\\u000a}\\u000a\\u000a//debugger;\\u000a\\u000aif ( ! startDate.value ) {\\u000a    startDate.value = new Date(new Date().getFullYear(), 0, 1);\\u000a}\\u000aif ( ! endDate.value ) {\\u000a    endDate.value = new Date(new Date().getFullYear(), 11, 31);\\u000a}\\u000a\\u000avar params = new URLSearchParams(window.location.search);\\u000aif ( params ) \\u000a  params = new URLSearchParams(window.location.href);\\u000avar userId = params.get('userId');\\u000avar accountId = params.get('accountId');\\u000aif ( accountId ) {\\u000a    let a = await this.__subContext__.accountDAO.find(accountId);\\u000a    account.value = a;\\u000a    // accountName.text = a.name;\\u000a    account.block.shown = false;\\u000a    let u = await this.__subContext__.userDAO.find(a.owner);\\u000a    user.value = u;\\u000a    // userName.text = u.toSummary();\\u000a    user.block.shown = false;\\u000a} else if ( userId ) {\\u000a    let u = await this.__subContext__.userDAO.find(userId);\\u000a    user.value = u;\\u000a    // userName.text = u.toSummary();\\u000a    user.block.shown = false;\\u000a} \\u000aif ( ! user || ! user.value ) return;\\u000aconsole.log('user', user.value.id);\\u000auserName.text = 'User: '+user.value.toSummary();\\u000a    // user.block.shown = true;\\u000a// userName.text = 'User: '+userName.text;\\u000a\\u000aif ( ! account || ! account.value ) return;\\u000aconsole.log('account', account.value.id);\\u000a    // account.block.shown = true;\\u000aaccountId = account.value.id;\\u000aaccountName.text = 'Account: '+account.value.name;\\u000a// accountName.text = 'Account: '+accountName.text;\\u000a\\u000alet td = this.__subContext__.transactionDAO\\u000a    .where(\\u000a        exp.AND(\\u000a            exp.OR(\\u000a                exp.EQ(hughes.ledger.Transaction.CREDIT_ACCOUNT, accountId),\\u000a                exp.EQ(hughes.ledger.Transaction.DEBIT_ACCOUNT, accountId)\\u000a            ),\\u000a            exp.GTE(hughes.ledger.Transaction.CREATED, startDate.value),\\u000a            exp.LTE(hughes.ledger.Transaction.CREATED, endDate.value)\\u000a        )\\u000a    )\\u000a    .orderBy(hughes.ledger.Transaction.CREATED);\\u000a\\u000alet s = await td.select();\\u000alet a = s.array;\\u000aif ( ! a ) return;\\u000a\\u000aconsole.log('transactions', a.length);\\u000avar bal = 0;\\u000afor ( const t of a ) {\\u000a    let e = hughes.ledger.LedgerEntry.create({\\u000a        id: t.id,\\u000a        date: t.created,\\u000a        event: t.event,\\u000a        creditAccount: t.creditAccount,\\u000a        debitAccount: t.debitAccount\\u000a    }, x);  \\u000a    if ( accountId == t.creditAccount ) {\\u000a        e.creditAmount = t.total;\\u000a        bal += e.creditAmount;\\u000a    } else {\\u000a        e.debitAmount = t.total;\\u000a        bal -= e.debitAmount;\\u000a    }\\u000a    e.balance = bal;\\u000a    led.put(e);\\u000a}\\u000abalance.value = bal;\\u000a\",\n\t\t\t\"autoRun\": true\n\t\t},\n\t\t\"borderClass\": \"foam.u2.borders.NullBorder\",\n\t\t\"border\": {\n\t\t\t\"cssClasses\": [\n\t\t\t\t\n\t\t\t],\n\t\t\t\"shown\": false\n\t\t}\n\t}\n]",lastModified:1759243681955})
