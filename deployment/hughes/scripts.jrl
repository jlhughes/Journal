p({class:"foam.core.script.Script",id:"SetTransactionEvent",code:"import hughes.journal.*;\nimport hughes.ledger.*;\n\ned = x.get(\"eventDAO\");\ntd = x.get(\"transactionDAO\");\nc = 0;\na = ed.select().getArray();\nfor ( e : a ) {\n  for ( t : e.getTransactions() ) {\n    t = td.find(t.getId());\n    if ( foam.util.SafetyUtil.isEmpty(t.getEvent()) ) {\n      t = t.fclone();\n      t.setEvent(e.getId());\n      t = td.put(t);\n      c++;\n    }\n  }\n}\nprint(\"updated: \"+c);",lastModified:1758840929571})
